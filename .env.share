# Used by `npm run build:share` (vite build --mode share).
#
# Vite loads .env.[mode] AFTER .env.local, so these blank values override whatever
# auto-login credentials .env.local holds. That matters because Vite inlines every VITE_*
# value into the JS bundle: with the password set, anyone who opened the shared URL could
# read it straight out of the bundle. Blank here means the shared build shows a normal
# login screen instead.
#
# Committed on purpose - it holds no secrets, and the share build must stay reproducible.
VITE_AUTO_LOGIN_EMAIL=
VITE_AUTO_LOGIN_PASSWORD=
